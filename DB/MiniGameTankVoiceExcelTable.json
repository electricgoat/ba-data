    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640217,
      "VoiceCondition": "CharacterSelect",
      "ChatBubbleType": "None",
      "VoiceClip": 1772242057,
      "SubtitleLocalizeKR": "백병전이 전문이지만…… 전차도 문제없어.",
      "SubtitleLocalizeJP": "専門は白兵戦だけど……戦車も問題ない。",
