    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640218,
      "VoiceCondition": "MiniGameStart",
      "ChatBubbleType": "None",
      "VoiceClip": 2611350336,
      "SubtitleLocalizeKR": "헌터 대기 중, 지시 부탁해.",
      "SubtitleLocalizeJP": "ハンター待機中。指示を求む。",
