    {
      "GroupId": 8431999016,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(수집한 데이터를 저장했어요.)",
      "LocalizeJP": "（集めたデータを保存した)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431999017,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(수집한 데이터를 저장했어.)",
      "LocalizeJP": "（収集データ、保存したぞ）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431999018,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(네루도 데이터를 가져와야 해요.)",
      "LocalizeJP": "（ネルにもデータを持ってきてもらわねば）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431999019,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(세이아도 데이터를 가져와야 해.)",
      "LocalizeJP": "（セイアのデータも必要だな）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(박스를 쓰면 움직이지 않을 땐 들키지 않을 거예요.)",
      "LocalizeJP": "（動かなければ気付かれないはずだ）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(타이밍을 잘 봐가며… 움직이죠.)",
      "LocalizeJP": "（タイミングを見て進もう）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…는 …",
      "LocalizeJP": "…は…。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…가…",
      "LocalizeJP": "…が…で…。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(조금 더…)",
      "LocalizeJP": "（まだ遠いな…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "곧 있으면 접선 시간이야.",
      "LocalizeJP": "そろそろ時間だ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "빨리 거래 끝내고 돌아가자.",
      "LocalizeJP": "早く渡して帰ろうぜ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(……이쯤이면 되겠죠.)",
      "LocalizeJP": "（…なるほど）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001040,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(아직 할 일이 있어요.)",
      "LocalizeJP": "（まだやることがある)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430001050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(잠시 기다려보죠.)",
      "LocalizeJP": "（少し待つとしよう)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(가다 보면 데이터 장치가 있다고 했지?)",
      "LocalizeJP": "（この先のロックされた部屋にはセキュリティキーがあるんだっけか）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(마음 같아선 다 때려 부수며 가고 싶지만…)",
      "LocalizeJP": "（もう全部ぶっ壊して進みてぇ…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…하여간 잠입은 취향이 아니라니까.)",
      "LocalizeJP": "（潜入って性に合わねぇんだよな）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(체력이 떨어지면... 회복약을 먹으면 된다고 했었지.)",
      "LocalizeJP": "（体力が減ってきたら……回復薬を飲めばいいんだっけか）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430003010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(아직 할 일이 있어.)",
      "LocalizeJP": "（まだやることがあってな)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(드론… 밀레니엄답네요. 트리니티와는 많이 달라요.)",
      "LocalizeJP": "（ドローン…トリニティでは想像できない光景だね）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이 통로 끝까지 가면… 문이 나오겠군요.)",
      "LocalizeJP": "（通路の突きあたりまで行けばドアがあるはずだが）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(강아지 로봇…)",
      "LocalizeJP": "（犬型ロボット…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "세이아, 이쪽이야.",
      "LocalizeJP": "セイア、こっちよ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "리오.",
      "LocalizeJP": "…リオか？",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "강아지 로봇에 통신기를 달았어.",
      "LocalizeJP": "通信機を取りつけてあるわ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "중간중간 수집한 데이터를 저장할 수 있어.",
      "LocalizeJP": "途中で収集したデータを保存できるようになっているの。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006020,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…이건 혼자서 지나갈 수 없겠어요.)",
      "LocalizeJP": "（ここは一人で通れそうにない）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006020,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(리오에게 연락해야겠군요.)",
      "LocalizeJP": "（リオに連絡しなくては）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "그러잖아도 이쪽에서 비밀 통로를 만들고 있었어.",
      "LocalizeJP": "ちょうど進路を確保していたところよ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "배전반을 조작해서 환풍기를 끄고 환풍구로 가면 돼.",
      "LocalizeJP": "換気扇を止めてもらえるかしら。そのままダクトを通れるはずよ。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006040,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이건… 배전반…?)",
      "LocalizeJP": "（これは…配電盤…？)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이제 환풍구로 들어갈 수 있겠어요.)",
      "LocalizeJP": "（これでダクトを通れそうだ)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8430006050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(서둘러서 이동해야겠네요.)",
      "LocalizeJP": "（急いで移動しよう)",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(저건……?)",
      "LocalizeJP": "（あれは…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이곳에도 있었네요. 요긴하겠어요.)",
      "LocalizeJP": "（ほかとは違う手掛かりのようだね）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431001010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이쯤에서 써 보면 되려나요……)",
      "LocalizeJP": "（このあたりに…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431001011,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(저거로군요. 성능 확실하네요.)",
      "LocalizeJP": "（…あれか。探知機があって助かった）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(일단 오기는 했는데……)",
      "LocalizeJP": "（到着…っと）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(조금 더 들어가 볼까.)",
      "LocalizeJP": "（…もう少し奥まで行くか）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(들키지 않고 접근하긴 어렵겠는데.)",
      "LocalizeJP": "（バレずに近づくのは厳しそうだな）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…리오가 준 무릎 보호대가 있었지.)",
      "LocalizeJP": "（ああ、そういえばニーパッドがあったな）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(마침 좋은 타이밍이네.)",
      "LocalizeJP": "（ちょうどよかった）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "이번 건만 성공하면 드디어 우리도 회식 한 번 하자고!",
      "LocalizeJP": "これが終わったらパアっとやろうぜ！",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "2차도 갈 수 있겠지!? 모처럼이니까!",
      "LocalizeJP": "二次会もやっちゃお！",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 3,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "저는 철판요리가 먹고 싶어요!",
      "LocalizeJP": "鉄板焼き！鉄板焼き食べたいっす！",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(소리를 내면 도망갈 수도 있는데….)",
      "LocalizeJP": "（銃は撃つなって言われてるしな…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Bulb",
      "Duration": 1000,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "[전구]",
      "LocalizeJP": "[전구]",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…맞다, 패드.)",
      "LocalizeJP": "（そういえば消音ストックがあったな）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(하여간 철두철미한 녀석이라니까.)",
      "LocalizeJP": "（…本当、隙のねぇヤツ）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(으음… 곤란해졌군요.)",
      "LocalizeJP": "（参ったな…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…무전기로 네루에게 연락할 수 있다 했었죠.)",
      "LocalizeJP": "（確かこれで連絡を取れるのだったか）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(어디 한 번 해볼까요.)",
      "LocalizeJP": "（繋がるといいのだが…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431003010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "어. 대충 상황은 알았어. 이쪽에서 뭔가 해볼게.",
      "LocalizeJP": "…ああ、大体分かった。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431003010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…배전반? 오케이. 내가 찾아볼게.",
      "LocalizeJP": "換気扇？了解、探してみる。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431004000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(세이아 쪽은…)",
      "LocalizeJP": "（セイアの方は…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431004000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…애도 아니고, 알아서 잘 하겠지.)",
      "LocalizeJP": "（…まぁ、適当にうまくやるだろ）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431004010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…저쪽에서 뭔가 해줘야겠는걸.)",
      "LocalizeJP": "（これは……あっちに頼もうぜ）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431005000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(……잘은 모르지만 반드시 빠져 나가야 해요.)",
      "LocalizeJP": "（ここから離れなくては）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431005000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(저의 직감이 말하고 있어요. 잡히면 끝이라고!)",
      "LocalizeJP": "（捕まってはならない…勘がそう告げている）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "……뭔가 이상한데요.",
      "LocalizeJP": "おかしい…",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(보통은 점점 경비가 강화될 텐데 말이죠.)",
      "LocalizeJP": "（この違和感は…）",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Dot",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "[…]",
      "LocalizeJP": "[…]",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Exclaim",
      "Duration": 1000,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "[!]",
      "LocalizeJP": "[!]",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "함정이에요, 처음부터 이걸 노린 거군요!",
      "LocalizeJP": "罠か…っ！",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006000,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "네루의 도움이 필요해요!",
      "LocalizeJP": "力を貸してほしい、ネル。",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006010,
      "TargetIndex": 0,
      "DialogType": "Exclaim",
      "Duration": 1000,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "[!]",
      "LocalizeJP": "[!]",
      "LocalizeTH": "",
      "LocalizeTW": "",
      "LocalizeEN": ""
    },
    {
      "GroupId": 8431006010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "이번엔 네루가 위험해요!",
      "LocalizeJP": "……ネルの身が危険だ。",
