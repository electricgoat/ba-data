    {
      "Id": 86000409,
      "CharacterId": 860004,
      "CostumeUniqueId": 1900957101,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "02",
      "Duration": 3080,
      "LocalizeKR": "후훗, 정보력의\n차이라는 거네.",
      "LocalizeJP": "ふふっ、これが\n情報の差よ。",
      "LocalizeTH": "ฮุฮุ ข้อมูลที่มี\nมันต่างกันนี่นะ",
      "LocalizeTW": "呵呵，這就是\n情報的差距哦。",
      "LocalizeEN": "Fufu. A difference of intel.",
      "VoiceId": 1692199428
    },
    {
      "Id": 86000410,
      "CharacterId": 860004,
      "CostumeUniqueId": 1900957101,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "01",
      "Duration": 1100,
      "LocalizeKR": "제법이잖아?",
      "LocalizeJP": "やるじゃない？",
      "LocalizeTH": "น่าประทับใจเลยใช่มั้ยล่ะ?",
      "LocalizeTW": "挺有一套的嘛？",
      "LocalizeEN": "Quite impressive, yes?",
      "VoiceId": 3339557552
    },
    {
      "Id": 86000411,
      "CharacterId": 860004,
      "CostumeUniqueId": 1900957101,
      "EventContentId": 860,
      "VoiceCondition": "LoseTurnSpecial",
      "AnimationName": "08",
      "Duration": 5020,
      "LocalizeKR": "어, 어라,\n왜 이런 결과가…?",
      "LocalizeJP": "あ、あれ、どうしてこんな結果になってしまったのかしら……？",
      "LocalizeTH": "อะ... เอ๋ ทำไมถึง\nเป็นแบบนี้ไปได้ล่ะ?",
      "LocalizeTW": "奇，奇怪？怎麼會變成這種結果呢……？",
      "LocalizeEN": "H-Huh, how did things turn out like this?",
      "VoiceId": 2151997505
    },
