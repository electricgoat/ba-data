      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640219,
      "VoiceCondition": "MiniGameStart",
      "ChatBubbleType": "None",
      "VoiceClip": 315453750,
      "SubtitleLocalizeKR": "전차, 전진!",
      "SubtitleLocalizeJP": "戦車、前進！",
      "SubtitlePortrait": "TankRacing_Portrait_Normal_CH0380"
    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640220,
      "VoiceCondition": "MiniGameStart",
      "ChatBubbleType": "None",
      "VoiceClip": 3294268990,
      "SubtitleLocalizeKR": "그린라이트, 가자!",
      "SubtitleLocalizeJP": "グリーンライトだ。行こう！",
      "SubtitlePortrait": "TankRacing_Portrait_Normal_CH0380"
    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640221,
      "VoiceCondition": "DashItemGet",
      "ChatBubbleType": "Dynamic",
      "VoiceClip": 1429808793,
      "SubtitleLocalizeKR": "전술적 우위, 점할 수 있겠어.",
      "SubtitleLocalizeJP": "有効活用しよう。",
      "SubtitlePortrait": "TankRacing_Portrait_Highlight_Ally_CH0380"
    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640222,
      "VoiceCondition": "EtcItemGet",
      "ChatBubbleType": "None",
      "VoiceClip": 2205749595,
      "SubtitleLocalizeKR": "현지 조달은 가능하면 해두자.",
      "SubtitleLocalizeJP": "現地調達できるのはありがたい。",
      "SubtitlePortrait": "TankRacing_Portrait_Normal_CH0380"
    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640223,
      "VoiceCondition": "EtcItemGet",
      "ChatBubbleType": "None",
      "VoiceClip": 3776470418,
      "SubtitleLocalizeKR": "장비 확보는 중요해. 지나치지 않아.",
      "SubtitleLocalizeJP": "装備の確保に、やりすぎはない。",
      "SubtitlePortrait": "TankRacing_Portrait_Normal_CH0380"
    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640224,
      "VoiceCondition": "GunFire",
      "ChatBubbleType": "None",
      "VoiceClip": 1120422031,
      "SubtitleLocalizeKR": "포미 확보!",
      "SubtitleLocalizeJP": "砲尾、確保！",
      "SubtitlePortrait": "TankRacing_Portrait_Normal_CH0380"
