      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640227,
      "VoiceCondition": "Combo",
      "ChatBubbleType": "Normal",
      "VoiceClip": 924314417,
      "SubtitleLocalizeKR": "공세 종말점, 멀지 않았어!",
