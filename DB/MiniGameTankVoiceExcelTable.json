    },
    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640226,
      "VoiceCondition": "Combo",
      "ChatBubbleType": "Normal",
      "VoiceClip": 3259856,
      "SubtitleLocalizeKR": "전과 확대, 성공적이야.",
      "SubtitleLocalizeJP": "戦果拡大。成功だな。",
