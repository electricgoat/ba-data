      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640228,
      "VoiceCondition": "Combo",
      "ChatBubbleType": "Normal",
      "VoiceClip": 2844273938,
      "SubtitleLocalizeKR": "표적 무력화, 다음!",
