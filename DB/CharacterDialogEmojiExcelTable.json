    {
      "GroupId": 8431999016,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(수집한 데이터를 저장했어요.)",
      "LocalizeJP": "（集めたデータを保存した)",
      "LocalizeTH": "(บันทึกข้อมูลที่รวบรวมได้\nเรียบร้อยแล้วค่ะ)",
      "LocalizeTW": "（收集的資料已儲存完畢）",
      "LocalizeEN": "(Collected data have been saved.)"
    },
    {
      "GroupId": 8431999017,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(수집한 데이터를 저장했어.)",
      "LocalizeJP": "（収集データ、保存したぞ）",
      "LocalizeTH": "(บันทึกข้อมูล\nที่รวบรวมได้เรียบร้อย)",
      "LocalizeTW": "（收集的資料儲存好了）",
      "LocalizeEN": "(Saved the collected data.)"
    },
    {
      "GroupId": 8431999018,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(네루도 데이터를 가져와야 해요.)",
      "LocalizeJP": "（ネルにもデータを持ってきてもらわねば）",
      "LocalizeTH": "(เนรุต้องได้รับข้อมูลนี้\nด้วยค่ะ)",
      "LocalizeTW": "（寧瑠也得把資料帶來才行）",
      "LocalizeEN": "(I need the data from Neru.)"
    },
    {
      "GroupId": 8431999019,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": false,
      "LocalizeKR": "(세이아도 데이터를 가져와야 해.)",
      "LocalizeJP": "（セイアのデータも必要だな）",
      "LocalizeTH": "(เซอาต้องได้ข้อมูลนี้ด้วย)",
      "LocalizeTW": "（聖亞也得把資料拿來才行）",
      "LocalizeEN": "(I need the data from Seia.)"
    },
    {
      "GroupId": 8430001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(박스를 쓰면 움직이지 않을 땐 들키지 않을 거예요.)",
      "LocalizeJP": "（動かなければ気付かれないはずだ）",
      "LocalizeTH": "(ถ้าเอากล่องมาสวมไว้\nตอนอยู่นิ่งๆ ก็จะ\nไม่โดนจับได้ค่ะ)",
      "LocalizeTW": "（戴上箱子的話，只要靜止不動就不會被發現了）",
      "LocalizeEN": "(If I stay still in this box, I won't get caught.)"
    },
    {
      "GroupId": 8430001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(타이밍을 잘 봐가며… 움직이죠.)",
      "LocalizeJP": "（タイミングを見て進もう）",
      "LocalizeTH": "(ดูจังหวะให้ดี...\nแล้วค่อยๆ ขยับ)",
      "LocalizeTW": "（抓準時機…行動吧！）",
      "LocalizeEN": "(Let's be wary of the timing...and get moving.)"
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…는 …",
      "LocalizeJP": "…は…。",
      "LocalizeTH": "อ่า...",
      "LocalizeTW": "…是…",
      "LocalizeEN": "...is..."
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…가…",
      "LocalizeJP": "…が…で…。",
      "LocalizeTH": "คือ...",
      "LocalizeTW": "…我…",
      "LocalizeEN": "...has..."
    },
    {
      "GroupId": 8430001010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(조금 더…)",
      "LocalizeJP": "（まだ遠いな…）",
      "LocalizeTH": "(อีกนิดหนึ่ง...)",
      "LocalizeTW": "（還有點距離…）",
      "LocalizeEN": "(Just a bit more...)"
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "곧 있으면 접선 시간이야.",
      "LocalizeJP": "そろそろ時間だ。",
      "LocalizeTH": "อีกเดี๋ยวก็จะ\nถึงเวลาติดต่อกันแล้ว",
      "LocalizeTW": "交接時間快到了。",
      "LocalizeEN": "It'll all be done soon."
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "빨리 거래 끝내고 돌아가자.",
      "LocalizeJP": "早く渡して帰ろうぜ。",
      "LocalizeTH": "รีบๆ จัดการให้จบ\nแล้วกลับดีกว่า",
      "LocalizeTW": "趕快完成交易回去吧！",
      "LocalizeEN": "Let's wrap up here and get back."
    },
    {
      "GroupId": 8430001030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(……이쯤이면 되겠죠.)",
      "LocalizeJP": "（…なるほど）",
      "LocalizeTH": "(เท่านี้น่าจะพอแล้วนะคะ...)",
      "LocalizeTW": "（……到這裡應該可以了）",
      "LocalizeEN": "(...This spot should be fine.)"
    },
    {
      "GroupId": 8430001040,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(아직 할 일이 있어요.)",
      "LocalizeJP": "（まだやることがある)",
      "LocalizeTH": "(ยังมีเรื่องที่ต้องทำอยู่ค่ะ)",
      "LocalizeTW": "（還有需要完成的事情）",
      "LocalizeEN": "(There are still things to do.)"
    },
    {
      "GroupId": 8430001050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(잠시 기다려보죠.)",
      "LocalizeJP": "（少し待つとしよう)",
      "LocalizeTH": "(รออีกแป๊บหนึ่งแล้วกันนะคะ)",
      "LocalizeTW": "（先等等看吧）",
      "LocalizeEN": "(Let's wait a bit.)"
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(가다 보면 데이터 장치가 있다고 했지?)",
      "LocalizeJP": "（この先のロックされた部屋にはセキュリティキーがあるんだっけか）",
      "LocalizeTH": "(น่าจะมีอุปกรณ์เก็บข้อมูล\nอยู่ระหว่างทางสินะ?)",
      "LocalizeTW": "（剛剛是說…過去就會有個數據裝置是吧？）",
      "LocalizeEN": "(There should be a data device along the way, right?)"
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(마음 같아선 다 때려 부수며 가고 싶지만…)",
      "LocalizeJP": "（もう全部ぶっ壊して進みてぇ…）",
      "LocalizeTH": "(อยากจะทุบทุกอย่างทิ้ง\nให้หมดจริงๆ เลยเชียว...)",
      "LocalizeTW": "（真想一鼓作氣衝過去…）",
      "LocalizeEN": "(I'd love to destroy everything in the way if I could...)"
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…하여간 잠입은 취향이 아니라니까.)",
      "LocalizeJP": "（潜入って性に合わねぇんだよな）",
      "LocalizeTH": "(ภารกิจแฝงตัวนี่\nไม่ใช่งานถนัดฉันเลยจริงๆ)",
      "LocalizeTW": "（…果然我還是不喜歡潛入行動）",
      "LocalizeEN": "(...Seriously, infiltration is not my style at all.)"
    },
    {
      "GroupId": 8430003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(체력이 떨어지면... 회복약을 먹으면 된다고 했었지.)",
      "LocalizeJP": "（体力が減ってきたら……回復薬を飲めばいいんだっけか）",
      "LocalizeTH": "(เห็นบอกว่าถ้าเริ่ม\nหมดแรง... ก็ให้กิน\nยาฟื้นฟูกำลังนี่สินะ)",
      "LocalizeTW": "（體力下降的話…好像可以喝恢復藥）",
      "LocalizeEN": "(If my HP drops...I should take some Recovery Medicine.)"
    },
    {
      "GroupId": 8430003010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(아직 할 일이 있어.)",
      "LocalizeJP": "（まだやることがあってな)",
      "LocalizeTH": "(ยังมีงานที่ต้องทำอยู่)",
      "LocalizeTW": "（還有事情得做）",
      "LocalizeEN": "(There are still things to do.)"
    },
    {
      "GroupId": 8430006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(드론… 밀레니엄답네요. 트리니티와는 많이 달라요.)",
      "LocalizeJP": "（ドローン…トリニティでは想像できない光景だね）",
      "LocalizeTH": "(โดรน... สมกับเป็นมิลเลเนียม\nจริงๆ เลยนะ ต่างจากทรีนิตี้\nจริงๆ ด้วยค่ะ)",
      "LocalizeTW": "（無人機…不愧是千年，跟三一截然不同呢）",
      "LocalizeEN": "(Drones...as expected of Millennium. Very different from Trinity.)"
    },
    {
      "GroupId": 8430006000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이 통로 끝까지 가면… 문이 나오겠군요.)",
      "LocalizeJP": "（通路の突きあたりまで行けばドアがあるはずだが）",
      "LocalizeTH": "(ถ้าเดินไปจนสุดทางนี้...\nก็จะเจอประตูสินะคะ)",
      "LocalizeTW": "（沿著這條通道走到底…就會有扇門吧）",
      "LocalizeEN": "(Once I reach the end of this hallway...there should be a door.)"
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(강아지 로봇…)",
      "LocalizeJP": "（犬型ロボット…）",
      "LocalizeTH": "(หุ่นยนต์น้องหมา...)",
      "LocalizeTW": "（機器狗…）",
      "LocalizeEN": "(Puppy Robot...)"
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "세이아, 이쪽이야.",
      "LocalizeJP": "セイア、こっちよ。",
      "LocalizeTH": "เซอา ทางนี้",
      "LocalizeTW": "聖亞，這邊。",
      "LocalizeEN": "This way, Seia."
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "리오.",
      "LocalizeJP": "…リオか？",
      "LocalizeTH": "ริโอะ",
      "LocalizeTW": "莉央。",
      "LocalizeEN": "Rio."
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "강아지 로봇에 통신기를 달았어.",
      "LocalizeJP": "通信機を取りつけてあるわ。",
      "LocalizeTH": "ฉันติดอุปกรณ์สื่อสาร\nไว้กับหุ่นยนต์น้องหมาแล้ว",
      "LocalizeTW": "我在機器狗上裝了通訊器。",
      "LocalizeEN": "I hooked a communicator up to the puppy robot."
    },
    {
      "GroupId": 8430006010,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "중간중간 수집한 데이터를 저장할 수 있어.",
      "LocalizeJP": "途中で収集したデータを保存できるようになっているの。",
      "LocalizeTH": "ระหว่างทางจะได้บันทึก\nข้อมูลที่รวบรวมมาได้",
      "LocalizeTW": "現在可以隨時儲存收集到的資料。",
      "LocalizeEN": "You can save the data you've collected along the way."
    },
    {
      "GroupId": 8430006020,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…이건 혼자서 지나갈 수 없겠어요.)",
      "LocalizeJP": "（ここは一人で通れそうにない）",
      "LocalizeTH": "(เรื่องนี้... ทำคนเดียว\nคงไม่สำเร็จแน่เลย)",
      "LocalizeTW": "（…這邊無法自行通過）",
      "LocalizeEN": "(...I don't think I can get across by myself.)"
    },
    {
      "GroupId": 8430006020,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(리오에게 연락해야겠군요.)",
      "LocalizeJP": "（リオに連絡しなくては）",
      "LocalizeTH": "(ติดต่อไปหาริโอะ\nน่าจะดีกว่า)",
      "LocalizeTW": "（看來得聯絡莉央了）",
      "LocalizeEN": "(I should call Rio.)"
    },
    {
      "GroupId": 8430006030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "그러잖아도 이쪽에서 비밀 통로를 만들고 있었어.",
      "LocalizeJP": "ちょうど進路を確保していたところよ。",
      "LocalizeTH": "พวกเขาสร้างทางลับ\nไว้ตรงนี้ด้วย",
      "LocalizeTW": "我也正在準備祕密通道。",
      "LocalizeEN": "I was charting your way in."
    },
    {
      "GroupId": 8430006030,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "배전반을 조작해서 환풍기를 끄고 환풍구로 가면 돼.",
      "LocalizeJP": "換気扇を止めてもらえるかしら。そのままダクトを通れるはずよ。",
      "LocalizeTH": "ปิดพัดลมระบายอากาศได้\nโดยกดสวิตช์ที่ตู้ไฟฟ้า\nและไปที่ช่องระบายอากาศ",
      "LocalizeTW": "操作配電盤關閉排風扇之後，就能通過排風口了。",
      "LocalizeEN": "Control the switchboard to turn off the ventilation fan and head toward the vent."
    },
    {
      "GroupId": 8430006040,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이건… 배전반…?)",
      "LocalizeJP": "（これは…配電盤…？)",
      "LocalizeTH": "(นี่คือ... ตู้ไฟฟ้า...?)",
      "LocalizeTW": "（這是…配電盤…？）",
      "LocalizeEN": "(Is this...the switchboard...?)"
    },
    {
      "GroupId": 8430006050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이제 환풍구로 들어갈 수 있겠어요.)",
      "LocalizeJP": "（これでダクトを通れそうだ)",
      "LocalizeTH": "(ตอนนี้เดินเข้าไปใน\nช่องระบายอากาศได้แล้ว)",
      "LocalizeTW": "（現在應該可以進入排風口了）",
      "LocalizeEN": "(I should be able to go inside the vent now.)"
    },
    {
      "GroupId": 8430006050,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(서둘러서 이동해야겠네요.)",
      "LocalizeJP": "（急いで移動しよう)",
      "LocalizeTH": "(ต้องรีบไปแล้วละ)",
      "LocalizeTW": "（趕緊移動吧）",
      "LocalizeEN": "(Let's hurry.)"
    },
    {
      "GroupId": 8431001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(저건……?)",
      "LocalizeJP": "（あれは…）",
      "LocalizeTH": "(นั่นมัน...?)",
      "LocalizeTW": "（那是……？）",
      "LocalizeEN": "(Is that...?)"
    },
    {
      "GroupId": 8431001000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이곳에도 있었네요. 요긴하겠어요.)",
      "LocalizeJP": "（ほかとは違う手掛かりのようだね）",
      "LocalizeTH": "(มีอยู่ที่นี่ด้วยสินะ...\nมีประโยชน์จริงๆ เลย)",
      "LocalizeTW": "（原來這裡也有啊。應該能派上用場）",
      "LocalizeEN": "(So there's one here too. Good.)"
    },
    {
      "GroupId": 8431001010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(이쯤에서 써 보면 되려나요……)",
      "LocalizeJP": "（このあたりに…）",
      "LocalizeTH": "(มาถึงตอนนี้แล้ว\nลองใช้ดูหน่อยดีมั้ยนะ...)",
      "LocalizeTW": "（現在可以用用看了嗎……）",
      "LocalizeEN": "(I suppose I can use it here...)"
    },
    {
      "GroupId": 8431001011,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(저거로군요. 성능 확실하네요.)",
      "LocalizeJP": "（…あれか。探知機があって助かった）",
      "LocalizeTH": "(อย่างนั้นเองสินะคะ\nมีประโยชน์จริงๆ ด้วย)",
      "LocalizeTW": "（原來是那個啊。性能真是不錯）",
      "LocalizeEN": "(So that's it. It really is useful.)"
    },
    {
      "GroupId": 8431002000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(일단 오기는 했는데……)",
      "LocalizeJP": "（到着…っと）",
      "LocalizeTH": "(ตอนนี้ก็มาถึงแล้ว...)",
      "LocalizeTW": "（成功抵達了……）",
      "LocalizeEN": "(Well, I've come this far...)"
    },
    {
      "GroupId": 8431002000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(조금 더 들어가 볼까.)",
      "LocalizeJP": "（…もう少し奥まで行くか）",
      "LocalizeTH": "(เข้าไปอีกหน่อยดีมั้ยนะ)",
      "LocalizeTW": "（再前進一點吧）",
      "LocalizeEN": "(Maybe I should go in a little further.)"
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(들키지 않고 접근하긴 어렵겠는데.)",
      "LocalizeJP": "（バレずに近づくのは厳しそうだな）",
      "LocalizeTH": "(เข้าไปให้ไม่โดนจับ\nน่าจะยากแฮะ)",
      "LocalizeTW": "（要在不被發現的情況下接近有點困難）",
      "LocalizeEN": "(It'd be hard to get close without getting caught.)"
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…리오가 준 무릎 보호대가 있었지.)",
      "LocalizeJP": "（ああ、そういえばニーパッドがあったな）",
      "LocalizeTH": "(มีแผ่นป้องกันเข่า\nที่ริโอะให้มาด้วยนี่นา)",
      "LocalizeTW": "（…話說莉央有給我一對護膝）",
      "LocalizeEN": "(...Rio did give me those knee pads.)"
    },
    {
      "GroupId": 8431002010,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(마침 좋은 타이밍이네.)",
      "LocalizeJP": "（ちょうどよかった）",
      "LocalizeTH": "(ได้จังหวะพอดีเลยนะ)",
      "LocalizeTW": "（正好能派上用場）",
      "LocalizeEN": "(Perfect timing.)"
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 1,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "이번 건만 성공하면 드디어 우리도 회식 한 번 하자고!",
      "LocalizeJP": "これが終わったらパアっとやろうぜ！",
      "LocalizeTH": "เสร็จงานนี้แล้ว\nไปหาอะไรอร่อยๆ\nกินฉลองกันเถอะ!",
      "LocalizeTW": "只要這次可以成功，我們就終於能吃上一次慶功宴了！",
      "LocalizeEN": "After this, let's go have a nice dinner to celebrate!"
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 2,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "2차도 갈 수 있겠지!? 모처럼이니까!",
      "LocalizeJP": "二次会もやっちゃお！",
      "LocalizeTH": "กินเสร็จแล้วไปฉลองต่อ\nรอบ 2 ได้ด้วยนี่นา?!\nนานๆ ทีนี่นะ!",
      "LocalizeTW": "就算要續攤也可以吧！？畢竟那麼難得！",
      "LocalizeEN": "Ooh, we could even get seconds for the occasion!"
    },
    {
      "GroupId": 8431002020,
      "TargetIndex": 3,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "저는 철판요리가 먹고 싶어요!",
      "LocalizeJP": "鉄板焼き！鉄板焼き食べたいっす！",
      "LocalizeTH": "ฉันอยากกินเทปันยากิค่ะ!",
      "LocalizeTW": "我想吃鐵板料理！",
      "LocalizeEN": "I want Teppanyaki!"
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(소리를 내면 도망갈 수도 있는데….)",
      "LocalizeJP": "（銃は撃つなって言われてるしな…）",
      "LocalizeTH": "(พวกมันอาจหนีไปก็ได้\nถ้าฉันส่งเสียงออกไป...)",
      "LocalizeTW": "（要是發出聲音的話，可能會被他們逃跑…）",
      "LocalizeEN": "(They might run away if I make a sound...)"
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Bulb",
      "Duration": 1000,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "[전구]",
      "LocalizeJP": "[전구]",
      "LocalizeTH": "[전구]",
      "LocalizeTW": "[전구]",
      "LocalizeEN": "[전구]"
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…맞다, 패드.)",
      "LocalizeJP": "（そういえば消音ストックがあったな）",
      "LocalizeTH": "(ใช่แล้ว... แผ่นรอง)",
      "LocalizeTW": "（…對了，墊子）",
      "LocalizeEN": "(...Right, knee pads.)"
    },
    {
      "GroupId": 8431002030,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(하여간 철두철미한 녀석이라니까.)",
      "LocalizeJP": "（…本当、隙のねぇヤツ）",
      "LocalizeTH": "(เป็นคนละเอียดรอบคอบ\nจริงๆ เลยนะ)",
      "LocalizeTW": "（那傢伙準備得還真徹底）",
      "LocalizeEN": "(Seriously, she's really thorough.)"
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(으음… 곤란해졌군요.)",
      "LocalizeJP": "（参ったな…）",
      "LocalizeTH": "(อืม... ชักจะยุ่งยากแล้วนะคะ)",
      "LocalizeTW": "（唔嗯…這下麻煩了）",
      "LocalizeEN": "(Mmm... This is a problem.)"
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(…무전기로 네루에게 연락할 수 있다 했었죠.)",
      "LocalizeJP": "（確かこれで連絡を取れるのだったか）",
      "LocalizeTH": "(ใช้เครื่องสื่อสารไร้สาย\nติดต่อเนรุได้สินะคะ...)",
      "LocalizeTW": "（…是說可以用無線電連絡寧瑠對吧）",
      "LocalizeEN": "(...Right, I can contact Neru with the walkie talkie.)"
    },
    {
      "GroupId": 8431003000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(어디 한 번 해볼까요.)",
      "LocalizeJP": "（繋がるといいのだが…）",
      "LocalizeTH": "(ไหนลองดูหน่อยซิ)",
      "LocalizeTW": "（來試試看吧）",
      "LocalizeEN": "(Let's give it a try.)"
    },
    {
      "GroupId": 8431003010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "어. 대충 상황은 알았어. 이쪽에서 뭔가 해볼게.",
      "LocalizeJP": "…ああ、大体分かった。",
      "LocalizeTH": "อ่า ฉันเข้าใจสถานการณ์แล้วละ\nจะลองทำอะไรสักอย่าง\nจากทางนี้ก็แล้วกัน",
      "LocalizeTW": "嗯，大致了解了。我從這邊想想辦法。",
      "LocalizeEN": "Yeah. I have a rough grasp of the situation. I'll try to do something about it from this side."
    },
    {
      "GroupId": 8431003010,
      "TargetIndex": 0,
      "DialogType": "Talk",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "…배전반? 오케이. 내가 찾아볼게.",
      "LocalizeJP": "換気扇？了解、探してみる。",
      "LocalizeTH": "ตู้ไฟฟ้า? โอเค\nฉันจะลองหาดู",
      "LocalizeTW": "…配電盤？好，我找找看。",
      "LocalizeEN": "...Switchoard? Okay. I'll look for it."
    },
    {
      "GroupId": 8431004000,
      "TargetIndex": 0,
      "DialogType": "Think",
      "Duration": 2500,
      "DurationKr": 0,
      "HideUI": true,
      "LocalizeKR": "(세이아 쪽은…)",
      "LocalizeJP": "（セイアの方は…）",
      "LocalizeTH": "(ทางด้านเซอา...)",
      "LocalizeTW": "（聖亞那邊…）",
      "LocalizeEN": "(And Seia...)"
