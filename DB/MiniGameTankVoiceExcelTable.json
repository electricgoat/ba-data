    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640225,
      "VoiceCondition": "GunFire",
      "ChatBubbleType": "None",
      "VoiceClip": 545861046,
      "SubtitleLocalizeKR": "차탄 준비! 폐쇄기 열어!",
