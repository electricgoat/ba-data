    {
      "Id": 86000109,
      "CharacterId": 860001,
      "CostumeUniqueId": 1900957001,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "13",
      "Duration": 3120,
      "LocalizeKR": "너는 게헨나\n워리어다!",
      "LocalizeJP": "お前はゲヘナの\nウォーリアーだ！",
      "LocalizeTH": "เจ้าคือนักรบ\nแห่งเกเฮนน่า!",
      "LocalizeTW": "你是格黑娜\n的戰士！",
      "LocalizeEN": "You are Gehenna's warrior!",
      "VoiceId": 3078117574
    },
    {
      "Id": 86000110,
      "CharacterId": 860001,
      "CostumeUniqueId": 1900957001,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "15",
      "Duration": 2270,
      "LocalizeKR": "요깃거리도\n안 되는군!",
      "LocalizeJP": "腹の足しにも\nならんな！",
      "LocalizeTH": "เรียกว่าลูกกระจ๊อก\nไม่ได้ด้วยซ้ำ!",
      "LocalizeTW": "連塞牙縫\n都不夠！",
      "LocalizeEN": "Barely even small fry!",
      "VoiceId": 2859250222
    },
    {
      "Id": 86000111,
      "CharacterId": 860001,
      "CostumeUniqueId": 1900957001,
      "EventContentId": 860,
      "VoiceCondition": "LoseTurnSpecial",
      "AnimationName": "07",
      "Duration": 3550,
      "LocalizeKR": "소라사키\n히나-!!",
      "LocalizeJP": "空崎\nヒナァーー！！",
      "LocalizeTH": "โซระซากิ ฮินะ!!!",
      "LocalizeTW": "空崎\n陽奈──！！",
      "LocalizeEN": "Sorasaki Hina!!!",
      "VoiceId": 1704699992
    },
