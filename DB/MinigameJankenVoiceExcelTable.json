    {
      "Id": 86000309,
      "CharacterId": 860003,
      "CostumeUniqueId": 1900957301,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "07",
      "Duration": 1920,
      "LocalizeKR": "나쁜 아이를 꼬\n집어 주는 거야!",
      "LocalizeJP": "意地悪は、メッ！",
      "LocalizeTH": "หนีบพวกนิสัยไม่ดี\nให้หมดเลย!",
      "LocalizeTW": "不可以壞壞！",
      "LocalizeEN": "Pinch the bad guys!",
      "VoiceId": 358319106
    },
    {
      "Id": 86000310,
      "CharacterId": 860003,
      "CostumeUniqueId": 1900957301,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "09",
      "Duration": 3080,
      "LocalizeKR": "꼬집이 씨,\n대단해!",
      "LocalizeJP": "カニカニさん、\nすごーい！",
      "LocalizeTH": "คุณก้ามหนีบ\nสุดยอดไปเลย!",
      "LocalizeTW": "夾夾先生，\n好厲害～！",
      "LocalizeEN": "Mr. Pinchy, you're incredible!",
      "VoiceId": 3407517078
    },
    {
      "Id": 86000311,
      "CharacterId": 860003,
      "CostumeUniqueId": 1900957301,
      "EventContentId": 860,
      "VoiceCondition": "LoseTurnSpecial",
      "AnimationName": "04",
      "Duration": 3320,
      "LocalizeKR": "아픈 거, 아픈 거\n날아가라!",
      "LocalizeJP": "痛いの、痛いの、\nとんでけー！",
      "LocalizeTH": "ความเจ็บเอ๋ย จงหายไป!",
      "LocalizeTW": "痛痛，痛痛，\n飛走吧～！",
      "LocalizeEN": "Pain, pain, go away!",
      "VoiceId": 2336583358
    },
