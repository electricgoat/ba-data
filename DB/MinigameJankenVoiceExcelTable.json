    {
      "Id": 86000209,
      "CharacterId": 860002,
      "CostumeUniqueId": 1900957201,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "13",
      "Duration": 3160,
      "LocalizeKR": "후후,\n이 정도려나요?",
      "LocalizeJP": "ふふっ。こんな\nものでしょうか。",
      "LocalizeTH": "ฮุฮุ แค่นี้พอรึเปล่าคะ?",
      "LocalizeTW": "呵呵，差不多\n就是這樣吧。",
      "LocalizeEN": "Fufu. That good enough?",
      "VoiceId": 4159284354
    },
    {
      "Id": 86000210,
      "CharacterId": 860002,
      "CostumeUniqueId": 1900957201,
      "EventContentId": 860,
      "VoiceCondition": "WinTurnSpecial",
      "AnimationName": "01",
      "Duration": 1390,
      "LocalizeKR": "적당히\n밥값은 하죠.",
      "LocalizeJP": "良い働きです。",
      "LocalizeTH": "คงต้องตั้งใจ\nสักหน่อยแล้วค่ะ",
      "LocalizeTW": "表現得不錯。",
      "LocalizeEN": "I guess I'll do my part.",
      "VoiceId": 1948256948
    },
    {
      "Id": 86000211,
      "CharacterId": 860002,
      "CostumeUniqueId": 1900957201,
      "EventContentId": 860,
      "VoiceCondition": "LoseTurnSpecial",
      "AnimationName": "04",
      "Duration": 1750,
      "LocalizeKR": "제가 이런\n실수를…!",
      "LocalizeJP": "私がこんな\nミスを……！",
      "LocalizeTH": "ฉันพลาดไป\nซะแล้ว...!",
      "LocalizeTW": "我竟然會犯\n這種錯誤……！",
      "LocalizeEN": "I messed up...!",
      "VoiceId": 714642512
    },
