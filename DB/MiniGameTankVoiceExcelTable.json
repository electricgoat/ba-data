    {
      "EventContentId": 864,
      "CharacterGroupId": 2,
      "UniqueId": 8640210,
      "VoiceCondition": "GunFire",
      "ChatBubbleType": "None",
      "VoiceClip": 2305042524,
      "SubtitleLocalizeKR": "탄피 배출 조심해주세요!",
